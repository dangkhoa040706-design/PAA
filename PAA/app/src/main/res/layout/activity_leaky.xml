<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/paa_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvLeakyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Leaky Activity Screen"
        android:textColor="@color/paa_scarlet"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvIteration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Lần mở: #1"
        android:textColor="@color/paa_ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Chế độ: BAD"
        android:textColor="@color/paa_ink_secondary"
        android:textSize="13sp" />

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Đang tự động đóng màn hình sau 350ms..."
        android:textColor="@color/paa_ink_secondary"
        android:textSize="12sp" />

</LinearLayout>
