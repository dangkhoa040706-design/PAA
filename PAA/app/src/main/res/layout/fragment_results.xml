<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paa_background">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/paa_surface"
        android:padding="12dp"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/paa_ink"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/title_results"
            android:textColor="@color/paa_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportCsv"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Xuất CSV"
            android:textSize="12sp"
            android:backgroundTint="@color/paa_scarlet"
            android:textColor="@color/paa_pearl"
            app:cornerRadius="8dp" />

        <ImageButton
            android:id="@+id/btnClearAll"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/paa_ink_secondary"
            android:contentDescription="Xóa toàn bộ lịch sử" />
    </LinearLayout>

    <!-- Module Selector Tabs -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupModules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipJank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jank Lab"
            android:checked="true"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CPU Lab"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMemory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memory Lab"
            style="@style/Widget.Material3.Chip.Filter" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Comparison Table Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardComparison"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="10dp"
        app:strokeColor="@color/paa_outline"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/paa_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvCompareHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BẢNG SO SÁNH TRƯỚC / SAU (TRUNG BÌNH)"
                android:textColor="@color/paa_scarlet"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Table Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/paa_surface_variant"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:text="Chỉ số"
                    android:textColor="@color/paa_ink"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="BAD"
                    android:textColor="@color/paa_bad"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="OPT"
                    android:textColor="@color/paa_opt"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:gravity="end"
                    android:text="Cải thiện"
                    android:textColor="@color/paa_ink"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Table Dynamic Rows Container -->
            <LinearLayout
                android:id="@+id/llComparisonRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvCompareNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chưa có dữ liệu..."
                android:textColor="@color/paa_ink_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- History List Header -->
    <TextView
        android:id="@+id/tvHistoryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:text="LỊCH SỬ CÁC LẦN ĐO"
        android:textColor="@color/paa_ink"
        android:textStyle="bold"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvEmptyHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Chưa có lần đo nào cho module này."
        android:textColor="@color/paa_ink_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- RecyclerView lịch sử -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
