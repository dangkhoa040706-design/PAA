<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/paa_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Controls chung: Tiêu đề, Switch BAD/OPT, nút Chạy đo/Hủy/Lưu -->
        <include
            android:id="@+id/headerControls"
            layout="@layout/layout_module_header_controls" />

        <!-- Card chọn kích thước tập dữ liệu N -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/paa_outline"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/paa_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bài toán: Tìm phần tử trùng &amp; Tính tổng"
                    android:textColor="@color/paa_ink"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Dữ liệu nạp từ cpu_data.csv (50.000 số nguyên ngẫu nhiên có phần tử trùng)."
                    android:textColor="@color/paa_ink_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Số lượng phần tử xử lý (N):"
                    android:textColor="@color/paa_ink"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgDataSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <RadioButton
                        android:id="@+id/rbSmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="10.000"
                        android:textColor="@color/paa_ink"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="30.000"
                        android:checked="true"
                        android:textColor="@color/paa_ink"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbLarge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="50.000"
                        android:textColor="@color/paa_ink"
                        android:textSize="13sp" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Result Panel: Bảng kết quả sau khi đo -->
        <include
            android:id="@+id/resultPanel"
            layout="@layout/layout_measurement_result_panel" />

        <!-- Card so sánh đáp số kiểm chứng BAD == OPT -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVerification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="@color/paa_surface_variant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ĐÁP SỐ THỰC NGHIỆM ĐỐI CHIẾU:"
                    android:textColor="@color/paa_ink"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvVerifyOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="-- / --"
                    android:textColor="@color/paa_ink"
                    android:textSize="13sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
