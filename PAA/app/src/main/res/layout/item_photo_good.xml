<?xml version="1.0" encoding="utf-8"?>
<!-- OPTIMIZED: Layout phẳng 1 tầng ConstraintLayout, không background lồng nhau, không overdraw -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivPhotoGood"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:contentDescription="Ảnh item OPTIMIZED" />

    <TextView
        android:id="@+id/tvTitleGood"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/paa_ink"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/ivPhotoGood"
        app:layout_constraintTop_toTopOf="@id/ivPhotoGood"
        app:layout_constraintEnd_toStartOf="@id/tvIdGood" />

    <TextView
        android:id="@+id/tvIdGood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/paa_opt"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivPhotoGood" />

    <TextView
        android:id="@+id/tvDescGood"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/paa_ink_secondary"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tvTitleGood"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitleGood"
        app:layout_constraintBottom_toBottomOf="@id/ivPhotoGood"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>
