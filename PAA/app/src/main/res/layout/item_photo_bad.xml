<?xml version="1.0" encoding="utf-8"?>
<!-- BAD: Layout lồng 5-6 tầng LinearLayout/RelativeLayout + Overdraw với nhiều background chồng chéo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@color/paa_background"> <!-- Tầng 1 (Background 1) -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp"
        android:background="@color/paa_surface_variant"> <!-- Tầng 2 (Background 2) -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:background="@color/paa_surface"> <!-- Tầng 3 (Background 3) -->

            <LinearLayout
                android:id="@+id/llContainerInner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp"
                android:background="#FFFFFF"> <!-- Tầng 4 (Background 4 - Overdraw) -->

                <!-- Ảnh lớn decode trên Main Thread -->
                <ImageView
                    android:id="@+id/ivPhotoBad"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Ảnh item BAD" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp"> <!-- Tầng 5 -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"> <!-- Tầng 6 -->

                        <TextView
                            android:id="@+id/tvTitleBad"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tiêu đề item"
                            android:textColor="@color/paa_ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvIdBad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="#1"
                            android:textColor="@color/paa_bad"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDescBad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:text="Mô tả nội dung item..."
                        android:textColor="@color/paa_ink_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</LinearLayout>
